# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Anthropic API key for generating plain-English summaries.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here

# REQUIRED by SEC EDGAR on every request. Format: "AppName your@email.com"
# Requests without a valid User-Agent are blocked by the SEC.
SEC_USER_AGENT=Orin your@email.com

# --- Clerk (authentication) --------------------------------------------------
# From Clerk dashboard → API keys. The publishable key is public-safe (it has
# the NEXT_PUBLIC_ prefix and ships to the browser by design). The secret key
# is server-only — never give it the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# --- Supabase (database) -----------------------------------------------------
# From Supabase dashboard → Project Settings → API Keys.
# URL and publishable key are public-safe (Row Level Security protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key BYPASSES Row Level Security. Server-only — never give it the
# NEXT_PUBLIC_ prefix. Used by lib/supabase/admin.ts for the shared filing
# cache, the discovery feed cache, and dashboard enrichment.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
